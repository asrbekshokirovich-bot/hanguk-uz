# Telegram API credentials — create an app at https://my.telegram.org → "API development tools"
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Where to send mirrored messages (the telegram-ingest edge function) + its secret.
# The secret must match the TELEGRAM_INGEST_SECRET set on the Supabase function.
INGEST_URL=https://lysjdtyanhdfphqyijsr.supabase.co/functions/v1/telegram-ingest
TELEGRAM_INGEST_SECRET=

# --- Sending (telegram-outbox) ----------------------------------------------
# The send queue sits next to the ingest function, so its URL is derived from
# INGEST_URL and the same secret authenticates it. Set OUTBOX_URL only if the
# two really are on different hosts.
# OUTBOX_URL=
# How often to poll for queued replies.
OUTBOX_POLL_MS=3000
# How often to report liveness. Keep well under the 5-minute staleness
# threshold used by send-telegram and infra-health-check.
HEARTBEAT_MS=60000
#
# For the CRM to route replies here at all, set TELEGRAM_SEND_VIA_USERBOT=1 in
# the Supabase function secrets. Until then send-telegram uses the Bot API and
# this queue stays empty.

# --- Accounts ---------------------------------------------------------------
# Single account: paste the string from `npm run login`.
TG_SESSION=
TG_LABEL=reception
# Optional: link this account to a staff profiles.user_id (for attribution).
TG_STAFF_USER_ID=

# Multiple accounts instead of TG_SESSION (JSON array; takes precedence):
# TG_ACCOUNTS=[{"label":"reception","staffUserId":null,"session":"1Ab..."},{"label":"dilnoza","staffUserId":"<uuid>","session":"1Cd..."}]

# --- Optional one-time history backfill -------------------------------------
# Run with BACKFILL_ON_START=1 once to import recent history, then run normally.
BACKFILL_DIALOGS=50
BACKFILL_LIMIT=100

# --- Browser login mode (Railway) -------------------------------------------
# Set LOGIN_MODE=1 to expose the one-time login page instead of running the bot.
# Open the service's public URL with ?k=<LOGIN_PASSWORD>, log in, copy the
# session into TG_SESSION, then set LOGIN_MODE=0 and redeploy.
LOGIN_MODE=0
LOGIN_PASSWORD=

