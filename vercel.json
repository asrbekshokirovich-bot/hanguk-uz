{
  "git": {
    "deploymentEnabled": { "main": true, "**": false }
  },
  "redirects": [
    { "source": "/ilova", "destination": "/ilova/", "permanent": false },
    { "source": "/ilova/app", "destination": "/ilova/app/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/((?!ilova/).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/ilova/",
      "destination": "https://hanguk-ilova.vercel.app/ilova/index.html"
    },
    {
      "source": "/ilova/app/",
      "destination": "https://hanguk-ilova.vercel.app/ilova/app/index.html"
    },
    {
      "source": "/ilova/:path*",
      "destination": "https://hanguk-ilova.vercel.app/ilova/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
