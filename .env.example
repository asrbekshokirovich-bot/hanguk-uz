# Hanguk CRM — frontend muhit o'zgaruvchilari
#
# Bu faylni `.env` ga nusxalang va qiymatlarni to'ldiring:
#   cp .env.example .env
#
# Qiymatlarni Supabase panelidan olasiz:
#   Project Settings → API
#
# Diqqat: faqat VITE_ bilan boshlanadigan o'zgaruvchilar brauzerga tushadi,
# shuning uchun bu yerga hech qachon maxfiy kalit (service_role) yozmang.

VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# --- Dev server (majburiy emas) ---
# Standart: 0.0.0.0:8080. Port band bo'lsa yoki faqat o'zingizga ochiq
# bo'lishini istasangiz o'zgartiring.
# VITE_DEV_HOST=127.0.0.1
# VITE_DEV_PORT=8080
