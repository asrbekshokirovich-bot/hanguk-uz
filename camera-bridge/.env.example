# Copy to .env before starting the stack.

TZ=Asia/Tashkent

# Supabase — the SERVICE ROLE key, not the anon key. The camera tables are
# owner/admin-only under RLS and the agent is neither; it writes as the
# service role. This key bypasses every policy in the project, so it must
# stay on the bridge and never reach the frontend bundle.
SUPABASE_URL=https://lysjdtyanhdfphqyijsr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Where recordings are written. Point this at the disk that has room for the
# retention window configured in frigate/config.yml (~1 TB per camera-month
# at 2K). Defaults to ./recordings next to this file.
RECORDINGS_PATH=./recordings

FRIGATE_URL=http://127.0.0.1:5000
POLL_INTERVAL_SECONDS=15
