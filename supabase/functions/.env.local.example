# ── Edge-function secrets for LOCAL development ───────────────────────────────
# Copy to `supabase/functions/.env.local` (gitignored) and fill in only the keys
# for the features you actually want to exercise locally. Then run:
#
#     npm run functions:serve          # supabase functions serve --env-file …
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by `supabase functions serve` for the local stack — do NOT set
# them here.
#
# Nothing below is required to run the app: the 19 core/CRUD functions
# (create-staff, create-student, student-login, guest-auth, document-proxy,
# get-pdf-url, dispatch-comm-jobs, …) work with only the auto-injected Supabase
# vars. The keys below unlock the AI / integration functions; each function that
# needs a missing key simply returns an error when invoked, and the rest of the
# app keeps working.

# ── AI (Google Gemini) — powers most AI functions: chat, lead/doc analysis,
#    translation, interview, study-plan, university search, call transcription.
GEMINI_API_KEY=""

# ── Web scraping / crawling (Firecrawl) — university & form discovery.
FIRECRAWL_API_KEY=""

# ── Speech (ElevenLabs) — TTS + Scribe speech-to-text, call recording analysis.
ELEVENLABS_API_KEY=""

# ── Telegram — inbound webhook + outbound messages, and the userbot ingest.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_INGEST_SECRET=""

# ── Instagram / Meta Graph API — DM webhook + sending.
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_VERIFY_TOKEN=""
# Optional overrides (sensible defaults exist in code):
# INSTAGRAM_GRAPH_API_HOST="graph.instagram.com"
# INSTAGRAM_GRAPH_API_VERSION="v21.0"

# ── HeyGen — streaming-avatar session token (interview avatar).
HEYGEN_API_KEY=""

# ── Business Command Center (external CRM sync).
BCC_API_KEY=""
BCC_BUSINESS_ID=""

# ── Korea public data open API (academyinfo import).
DATA_GO_KR_SERVICE_KEY=""

# ── Mediateka — call-recording ingestion.
MEDIATEKA_API_KEY=""
MEDIATEKA_WEBHOOK_SECRET=""

# ── Voximplant — VoIP webhook.
VOXIMPLANT_API_KEY=""

# ── TURN / WebRTC voice credentials (turn-credentials function).
TURN_SECRET=""
TURN_TTL="86400"
TURN_URLS=""
