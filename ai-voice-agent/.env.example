# ---- Azure Communication Services (the phone leg) --------------------------
# Resource → "Keys" → Connection string.
ACS_CONNECTION_STRING=
# ACS-owned phone number (E.164) used as caller-id for OUTBOUND calls.
ACS_CALLER_ID=+1XXXXXXXXXX

# Public HTTPS origin of THIS worker (ACS posts call-lifecycle callbacks here).
PUBLIC_BASE_URL=https://your-worker.example.com
# Public wss:// origin ACS streams media to. Usually the same host as above.
PUBLIC_WS_URL=wss://your-worker.example.com

# ---- Azure OpenAI Realtime (the brain) -------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
# Deployment name of a gpt-4o-realtime model (Azure Studio → Deployments).
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-4o-realtime-preview
AZURE_OPENAI_REALTIME_API_VERSION=2024-10-01-preview
# Voice: alloy | ash | ballad | coral | echo | sage | shimmer | verse
AZURE_OPENAI_REALTIME_VOICE=alloy

# ---- Wiring back into Supabase / CRM ---------------------------------------
# The ai-call-ingest edge function + the secret it requires.
INGEST_URL=https://hyvxwlwttzxzrkfolivo.supabase.co/functions/v1/ai-call-ingest
AI_AGENT_INGEST_SECRET=

# Shared secret the ai-place-call edge function presents to /outbound here.
AGENT_SECRET=

# ---- Server ----------------------------------------------------------------
PORT=8080
# Comma-separated org/greeting language hint (informational; see prompt.mjs).
DEFAULT_GREETING_LANG=uz
