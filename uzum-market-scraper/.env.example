# ---------------------------------------------------------------------------
# Uzum Market scraper configuration
#
# Copy this file to `.env` and fill in the values, or export them in your
# shell. Every setting can also be passed as a CLI flag (flags win over env).
#
#   cp .env.example .env
#
# HOW TO GET A TOKEN (required for most endpoints)
# ------------------------------------------------
# Uzum's catalog API sits behind an auth gateway. The web app uses a short-lived
# Bearer token plus an installation id (x-iid). The easiest way to obtain both:
#
#   1. Open https://uzum.uz in a desktop browser and browse any category.
#   2. Open DevTools -> Network tab, filter by "graphql".
#   3. Click any request to graphql.uzum.uz, find the Request Headers.
#   4. Copy the "authorization" value (everything after "Bearer ") and the
#      "x-iid" value into the variables below.
#
# Even easier: right-click that request -> Copy -> "Copy as cURL", then run
#      uzum-scraper auth --from-curl-file curl.txt
# and this scraper will extract the token + x-iid + language for you.
#
# Tokens expire (typically within an hour). Re-grab when you start getting 401s.
# ---------------------------------------------------------------------------

# The Bearer token (paste WITHOUT the leading "Bearer ").
UZUM_AUTH_TOKEN=

# Installation id sent as the x-iid header. If left blank, a random UUID is
# generated and cached in ~/.config/uzum-scraper/iid so it stays stable.
UZUM_IID=

# Interface / content language: uz-UZ, ru-RU, or en-US.
UZUM_LANGUAGE=uz-UZ

# --- Politeness / rate limiting -------------------------------------------
# Minimum seconds between requests (float). Be respectful; don't hammer.
UZUM_MIN_DELAY=0.7
# Extra random jitter (0..N seconds) added to each delay to look less robotic.
UZUM_JITTER=0.6
# Max retries on transient failures (429/5xx/network) before giving up.
UZUM_MAX_RETRIES=5
# Per-request timeout in seconds.
UZUM_TIMEOUT=30

# --- Endpoints (override only if Uzum moves hosts) ------------------------
UZUM_REST_BASE=https://api.uzum.uz/api
UZUM_GRAPHQL_URL=https://graphql.uzum.uz/

# --- Output ----------------------------------------------------------------
# Default directory for scraped JSON/CSV output.
UZUM_OUTPUT_DIR=./data
