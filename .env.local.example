# ── Frontend env for LOCAL development ───────────────────────────────────────
# Copy to `.env.local` (gitignored) to point the app at the LOCAL Supabase stack.
# Vite loads `.env.local` ahead of the committed `.env`, so this transparently
# overrides the hosted/cloud values — no source changes needed.
#
# EASIEST: don't copy this by hand. After `supabase start`, run:
#     npm run env:local
# which writes `.env.local` with the exact keys your running stack printed.
#
# The values below are the Supabase CLI's well-known local defaults and work as
# long as you haven't customised the JWT secret in supabase/config.toml.

VITE_SUPABASE_URL="http://127.0.0.1:54321"

# Local anon (publishable) key — the standard Supabase CLI demo key. If your
# `supabase status` prints a different ANON_KEY, use that instead (or run
# `npm run env:local`).
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"

VITE_SUPABASE_PROJECT_ID="local"

# ── Optional: WebRTC voice (staff calls). Unset → falls back to STUN only. ─────
# VITE_TURN_FUNCTION=""
# VITE_TURN_ICE_ENDPOINT=""
# VITE_TURN_URLS=""
# VITE_TURN_USERNAME=""
# VITE_TURN_CREDENTIAL=""
